# Nomor HP merchant untuk login OTP, format 62...
MERCHANT_PHONE=

# Merchant id GoPay Merchant, format G000000001
MERCHANT_ID=

# QRIS statis outlet. Kosongkan bila provider discovering sendiri dari profil merchant.
STATIC_QRIS=

# Lokasi file kredensial. Jangan di-commit.
SESSION_FILE=./.data/session.json

# Target webhook untuk notifikasi paid/expired. Kosongkan untuk mematikan webhook.
WEBHOOK_URL=
# Kunci HMAC-SHA256 untuk menandatangani webhook.
WEBHOOK_SECRET=

PORT=3000

# Kunci API untuk endpoint pembayaran (header x-api-key). Kosongkan untuk mematikan.
API_KEY=

# Kalimat sandi enkripsi file session. Kosongkan untuk menyimpan tanpa enkripsi.
SESSION_PASSPHRASE=

# Tuning rekonsiliasi
POLL_INTERVAL_MS=5000
DEFAULT_EXPIRY_MS=300000
CLOCK_SKEW_MS=60000
MAX_UNIQUE_OFFSET=999